# Next.js app
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB=mobilerun
EXECUTOR_URL=http://127.0.0.1:8765
EXECUTOR_TOKEN=change-me

# Python executor (api/): same token, plus optional host/port
# EXECUTOR_TOKEN=change-me
# EXECUTOR_HOST=127.0.0.1
# EXECUTOR_PORT=8765
# MOBILERUN_CONFIG=/path/to/config.yaml   # optional; defaults to the framework's user config
# OPENROUTER_API_KEY=                     # required when llm_profiles use provider: OpenRouter
# TYPESAFE_API_KEY=                       # enables the TypeSafe Jev agent (https://console.typesafe.ai)
# TYPESAFE_MODEL=jev-latest               # pin a fixed Jev version when comparing runs
# TYPESAFE_BASE_URL=https://openrouter.ai/api  # call Jev through OpenRouter; OPENROUTER_API_KEY is used
#                                              # when TYPESAFE_API_KEY is unset
